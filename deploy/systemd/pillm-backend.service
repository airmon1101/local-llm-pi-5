[Unit]
Description=PiLLM FastAPI Backend Service
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=%USER%
WorkingDirectory=%PILLM_DIR%/backend
Environment="PATH=%PILLM_DIR%/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%PILLM_DIR%/backend/.env
ExecStart=%PILLM_DIR%/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=always
RestartSec=5s
KillMode=process

# MicroSD Endurance & Resource Caps
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pillm-backend
MemoryMax=1500M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
