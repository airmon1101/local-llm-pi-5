# PiLLM Backend Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
APP_VERSION=1.0.0

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_THREADS=4
OLLAMA_NUM_CTX=2048

# Database Configuration (Relative to backend directory or absolute path)
DATABASE_PATH=../data/pillm.db

# Storage Alert Thresholds (Optimized for 64GB MicroSD)
STORAGE_WARNING_THRESHOLD_PERCENT=10.0
STORAGE_WARNING_THRESHOLD_GB=5.0

# Default System Prompt
DEFAULT_SYSTEM_PROMPT="You are PiLLM, a helpful AI assistant running locally on a Raspberry Pi. Provide accurate, practical, and easy-to-understand answers. When answering technical questions, provide useful examples."
